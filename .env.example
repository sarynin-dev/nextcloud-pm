# ====== Параметры развёртывания корпоративного облака ======
# Скопируйте этот файл в .env и задайте свои пароли:  cp .env.example .env

# Доменное имя (для локального стенда — localhost)
NC_DOMAIN=localhost

# Учётная запись администратора Nextcloud
NC_ADMIN_USER=admin
NC_ADMIN_PASSWORD=ChangeMe_Admin123

# База данных PostgreSQL
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=ChangeMe_Db123

# Пароль для Redis (кэш и блокировки файлов)
REDIS_PASSWORD=ChangeMe_Redis123

# Пароль по умолчанию для демонстрационных сотрудников (scripts/setup.sh)
DEMO_USER_PASSWORD=Proekt_2026!
